<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/icons/iconpark/icons-gallery"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type gallery:Navigation}" TargetType="gallery:Navigation">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}">
                    <DockPanel VerticalSpacing="5" LastChildFill="True">
                        <atom:ComboBox Name="{x:Static gallery:NavigationThemeConstants.IconThemeComboBoxPart}"
                                       DockPanel.Dock="Top"
                                       HorizontalAlignment="Stretch" SelectedIndex="1"
                                       Margin="0 0 0 10">
                            <atom:ComboBoxItem Tag="{x:Static atom:IconThemeType.Outlined}">
                                <TextBlock Text="{gallery:NavigationLangResource IconThemeOutlined}" />
                            </atom:ComboBoxItem>
                            <atom:ComboBoxItem Tag="{x:Static atom:IconThemeType.Filled}">
                                <TextBlock Text="{gallery:NavigationLangResource IconThemeFilled}" />
                            </atom:ComboBoxItem>
                            <atom:ComboBoxItem Tag="{x:Static atom:IconThemeType.TwoTone}">
                                <TextBlock Text="{gallery:NavigationLangResource IconThemeTwoTone}" />
                            </atom:ComboBoxItem>
                            <atom:ComboBoxItem Tag="{x:Static atom:IconThemeType.MultiColor}">
                                <TextBlock Text="{gallery:NavigationLangResource IconThemeMultiColor}" />
                            </atom:ComboBoxItem>
                        </atom:ComboBox>
                        <TextBlock DockPanel.Dock="Top"
                                   FontWeight="Bold"
                                   Text="{gallery:NavigationLangResource CategoryLabel}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="False"
                                      BringIntoViewOnFocusChange="False">
                            <atom:NavMenu Name="{x:Static gallery:NavigationThemeConstants.CategoryNavMenuPart}"
                                          Mode="Inline"
                                          ItemsSource="{TemplateBinding CategoryMavMenuItems}">
                                <atom:NavMenu.ItemTemplate>
                                    <DataTemplate x:DataType="atom:NavMenuNode">
                                        <TextBlock Text="{Binding Header}" />
                                    </DataTemplate>
                                </atom:NavMenu.ItemTemplate>
                            </atom:NavMenu>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ atom|NavMenu#PART_CategoryNavMenu[Mode=Inline]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Setter Property="Width" Value="{gallery:NavigationTokenResource PanelWidth}" />
        <Setter Property="Padding" Value="{atom:SharedTokenResource PaddingXS}" />

    </ControlTheme>
</ResourceDictionary>
