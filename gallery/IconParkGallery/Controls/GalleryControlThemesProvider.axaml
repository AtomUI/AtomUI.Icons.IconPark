<atom:ControlThemesProvider xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:atom="https://atomui.net"
                            x:Class="IconParkGallery.Controls.GalleryControlThemesProvider"
                            Id="IconParkGallery.Controls">
    <atom:ControlThemesProvider.ControlThemes>
        <ResourceInclude Source="IconGallery/Themes/IconGalleryThemes.axaml" />
        <ResourceInclude Source="Navigation/Themes/NavigationThemes.axaml" />
    </atom:ControlThemesProvider.ControlThemes>
</atom:ControlThemesProvider>